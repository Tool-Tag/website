NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only Supabase access for workers and secure private-file delivery; never NEXT_PUBLIC.
# Prefer SUPABASE_SECRET_KEY when available; legacy service-role remains supported.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# preview/test never send. test-delivery sends only to TOOLTAG_MAIL_TEST_RECIPIENT.
# live permits customer delivery only after the acceptance test is completed.
TOOLTAG_MAIL_MODE=preview
TOOLTAG_PUBLIC_URL=https://tooltag.martinlab.studio

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
TOOLTAG_MAIL_TEST_RECIPIENT=
TOOLTAG_MAIL_ALLOW_LOCAL_SEND=false
TOOLTAG_MAIL_QUOTES_FROM=quotes@tooltag.martinlab.studio
TOOLTAG_MAIL_QUOTES_REPLY_TO=quotes@tooltag.martinlab.studio
TOOLTAG_MAIL_BILLING_FROM=billing@tooltag.martinlab.studio
TOOLTAG_MAIL_BILLING_REPLY_TO=billing@tooltag.martinlab.studio
TOOLTAG_MAIL_SUPPORT_FROM=support@tooltag.martinlab.studio
TOOLTAG_MAIL_SUPPORT_REPLY_TO=support@tooltag.martinlab.studio
TOOLTAG_MAIL_NOTIFICATIONS_FROM=notifications@tooltag.martinlab.studio
TOOLTAG_MAIL_NOTIFICATIONS_REPLY_TO=notifications@tooltag.martinlab.studio
TOOLTAG_MAIL_HELLO_FROM=hello@tooltag.martinlab.studio
TOOLTAG_MAIL_HELLO_REPLY_TO=hello@tooltag.martinlab.studio
TOOLTAG_MAIL_PURCHASES_FROM=purchases@tooltag.martinlab.studio
TOOLTAG_MAIL_PURCHASES_REPLY_TO=purchases@tooltag.martinlab.studio

# Hosted Stripe Checkout. Card payments remain disabled until both are configured.
# TEST only in this phase: sk_test_... / pk_test_... / whsec_...; never commit values.
STRIPE_SECRET_KEY=
# Public pk_test_ key; hosted Checkout does not require browser Stripe.js. Never put sk_ here.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional override for mocked/integration test endpoints. Production should use Stripe default.
STRIPE_API_BASE=

# Route compensation refunds: disabled by default. Live requires production + sk_live key.
# test is restricted to non-production and sk_test keys; never use real customer payments.
TOOLTAG_REFUND_MODE=disabled

# Optional registration SMS ownership check. Leave disabled until AWS SMS is ready.
PHONE_VERIFICATION_ENABLED=false

# Phase B inbox: disabled by default; never pulls/sends from local or preview.
# Existing Google refresh token must include gmail.readonly AND gmail.send.
TOOLTAG_SUPPORT_INBOX_ENABLED=false
TOOLTAG_INBOX_SUPPORT_ADDRESS=support@tooltag.martinlab.studio
TOOLTAG_INBOX_HELLO_ADDRESS=hello@tooltag.martinlab.studio
